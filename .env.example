# SYSUDate deployment environment variables
# Copy this template into your deployment platform and fill real values there.
# Do not commit real passwords, secrets, access keys, or tokens.

MYSQL_HOST=<your-rds-mysql-host>
MYSQL_PORT=3306
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=sysudate

ACCOUNT_NAME=<your-email-account>
FROM_ALIAS=SYSU Date
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_PASSWORD=<your-smtp-password>

JWT_SECRET=<generate-a-long-random-secret>
ADMIN_USERNAME=<your-admin-username>
ADMIN_PASSWORD=<your-admin-password>
