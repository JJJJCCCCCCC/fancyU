const express = require('express');
const crypto = require('crypto');
const nodemailer = require('nodemailer');
const mysql = require('mysql2/promise');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');

const app = express();
app.use(express.json({ limit: '10mb' }));

// 安全响应头
app.use((req, res, next) => {
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-Frame-Options', 'DENY');
    res.setHeader('X-XSS-Protection', '1; mode=block');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains');
    res.setHeader('Content-Security-Policy', "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self'");
    next();
});

// ==================== 从环境变量读取配置 ====================

const MYSQL_HOST = process.env.MYSQL_HOST;
const MYSQL_PORT = parseInt(process.env.MYSQL_PORT || '3306');
const MYSQL_USER = process.env.MYSQL_USER;
const MYSQL_PASSWORD = process.env.MYSQL_PASSWORD;
const MYSQL_DATABASE = process.env.MYSQL_DATABASE || 'sysudate';

const ACCOUNT_NAME = process.env.ACCOUNT_NAME || 'sysudate.verify@sysudate.cn';
const FROM_ALIAS = process.env.FROM_ALIAS || 'FancyU';
const SMTP_PASSWORD = process.env.SMTP_PASSWORD || '';
const SMTP_HOST = process.env.SMTP_HOST || 'smtpdm.aliyun.com';
const SMTP_PORT = parseInt(process.env.SMTP_PORT || '465');

const JWT_SECRET = process.env.JWT_SECRET;
const JWT_EXPIRES_IN = '30d';

if (!JWT_SECRET) {
    console.error('❌ 缺少必需的环境变量: JWT_SECRET');
    throw new Error('Missing required environment variable: JWT_SECRET');
}

if (!MYSQL_HOST || !MYSQL_USER || !MYSQL_PASSWORD) {
    console.error('❌ 缺少必需的环境变量: MYSQL_HOST, MYSQL_USER, MYSQL_PASSWORD');
    throw new Error('Missing required environment variables');
}

if (!SMTP_PASSWORD) {
    console.warn('⚠️ SMTP_PASSWORD 未设置，邮件发送功能可能不可用');
}

console.log('✅ 环境变量验证通过');
console.log(`📧 邮件账户: ${ACCOUNT_NAME}`);
console.log(`🗄️ 数据库: ${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}`);

const rateLimitMap = new Map();

const transporter = nodemailer.createTransport({
    host: SMTP_HOST,
    port: SMTP_PORT,
    secure: SMTP_PORT === 465,
    auth: { user: ACCOUNT_NAME, pass: SMTP_PASSWORD }
});

let pool = null;

async function getPool() {
    if (!pool) {
        pool = await mysql.createPool({
            host: MYSQL_HOST,
            port: MYSQL_PORT,
            user: MYSQL_USER,
            password: MYSQL_PASSWORD,
            database: MYSQL_DATABASE,
            waitForConnections: true,
            connectionLimit: 10,
            enableKeepAlive: true,
            keepAliveInitialDelay: 0
        });
    }
    return pool;
}

// ==================== 频率限制 ====================

function checkRateLimit(ip, action, limit = 10, windowMs = 60000) {
    const key = `${ip}:${action}`;
    const now = Date.now();
    const record = rateLimitMap.get(key) || [];
    const recent = record.filter(t => now - t < windowMs);
    if (recent.length >= limit) return false;
    recent.push(now);
    rateLimitMap.set(key, recent);
    if (Math.random() < 0.01) {
        for (const [k, times] of rateLimitMap.entries()) {
            const cleanTimes = times.filter(t => now - t < 600000);
            if (cleanTimes.length === 0) rateLimitMap.delete(k);
            else rateLimitMap.set(k, cleanTimes);
        }
    }
    return true;
}

// ==================== 验证码存储 ====================

const codeStore = new Map();

function storeCode(email, code, action, expiresMinutes = 10) {
    const key = `${email}:${action}`;
    codeStore.set(key, { code, expiresAt: Date.now() + expiresMinutes * 60000 });
}

function verifyCode(email, code, action, deleteAfterVerify = true) {
    const key = `${email}:${action}`;
    const record = codeStore.get(key);
    if (!record) return false;
    if (Date.now() > record.expiresAt) {
        codeStore.delete(key);
        return false;
    }
    const valid = record.code === code;
    if (valid && deleteAfterVerify) codeStore.delete(key);
    return valid;
}

function generateCode() {
    return Math.floor(100000 + Math.random() * 900000).toString();
}

function generateSerial() {
    return 'SYSU-' + crypto.randomUUID().toUpperCase();
}

// ==================== JWT ====================

function signToken(payload) {
    return jwt.sign(payload, JWT_SECRET, { expiresIn: JWT_EXPIRES_IN });
}

function verifyToken(token) {
    try {
        return jwt.verify(token, JWT_SECRET);
    } catch (e) {
        return null;
    }
}

// ==================== 邮件发送 ====================

async function sendEmail(to, subject, html) {
    try {
        await transporter.sendMail({
            from: `"${FROM_ALIAS}" <${ACCOUNT_NAME}>`,
            to,
            subject,
            html
        });
        return true;
    } catch (e) {
        console.error('邮件发送失败:', e.message);
        return false;
    }
}

// ==================== 中间件 ====================

function authMiddleware(req, res, next) {
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
        return res.json({ code: 401, msg: '未登录' });
    }
    const token = authHeader.slice(7);
    const decoded = verifyToken(token);
    if (!decoded || !decoded.userId) {
        return res.json({ code: 401, msg: '登录已过期' });
    }
    req.user = decoded;
    next();
}

function adminAuthMiddleware(req, res, next) {
    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
        return res.json({ code: 401, msg: '未登录' });
    }
    const token = authHeader.slice(7);
    const decoded = verifyToken(token);
    if (!decoded || !decoded.isAdmin) {
        return res.json({ code: 403, msg: '无管理员权限' });
    }
    next();
}

